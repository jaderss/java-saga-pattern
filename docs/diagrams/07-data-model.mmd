        uuid id PK
        text idempotency_key UK
        text source_account_id
        text destination_account_id
        numeric amount
        char currency
        jsonb faults
        text status
        text current_step
        text current_action
        int attempt
        timestamptz deadline
        text reason
    }
    SAGA_STEP {
        uuid saga_id PK
        int position PK
        text step
        text status
    }
    SAGA_EVENT {
        bigint id PK
        uuid saga_id FK
        text type
        text step
        text action
        int attempt
        text detail
    }

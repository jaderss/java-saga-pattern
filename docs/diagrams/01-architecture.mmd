flowchart TB
    browser([Browser<br/>React, Vite, Tailwind, shadcn/ui])
    web[web<br/>nginx: static page, /api proxy]

    transfer["<b>transfer-service</b><br/>orchestrator<br/>REST, SSE, saga state machine,<br/>timeout scan, outbox relay"]
    account["<b>account-service</b><br/>participant<br/>debit, credit, refund, reversal,<br/>step_record, outbox relay"]
    risk["<b>risk-service</b><br/>participant<br/>limit reserve and clear, watchlist,<br/>step_record, outbox relay"]

    subgraph kafka[Kafka, key = saga id]
        rc[[saga.risk.commands]]
        ac[[saga.account.commands]]
        rep[[saga.transfer.replies]]
    end

    tdb[(Postgres: transfer<br/>saga, saga_step, saga_event, outbox)]
    adb[(Postgres: account<br/>account, account_entry, step_record, outbox)]
    rdb[(Postgres: risk<br/>limit_usage, reservation, watchlist,<br/>step_record, outbox)]

    browser -- HTTP and SSE --> web
    web -- /api/transfers, /api/scenarios --> transfer
    web -. /api/accounts .-> account
    web -. /api/limits .-> risk

    transfer -- commands --> rc
    transfer -- commands --> ac
    rc --> risk
    ac --> account
    risk -- replies --> rep
    account -- replies --> rep
    rep --> transfer

    transfer --- tdb
    account --- adb
    risk --- rdb
